rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Defines the rules for the 'posts' collection
    match /posts/{postId} {
      // Anyone can read documents in the 'posts' collection.
      // This is necessary for your blog to be public.
      allow read: if true;

      // Only authenticated users can create, update, or delete documents.
      // This secures your admin functionality.
      allow write: if request.auth != null;
    }
  }
}
